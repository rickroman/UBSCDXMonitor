<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Appium Demo Suite" verbose="0" parallel="tests" thread-count="2">
    <listeners>
        <listener class-name="com.quantum.listeners.QuantumReportiumListener"/>
    </listeners>

    <!-- To use actual AppiumDriver classes defined    -->
    <!-- by driverClass property in env.resources dirs -->
    <!-- Set driver.name value to perfectoDriver       -->
    <parameter name="driver.name" value="perfectoDriver"/>
    <parameter name="perfecto.capabilities.securityToken" value="eyJhbGciOiJIUzI1NiIsInR5cCIgOiAiSldUIiwia2lkIiA6ICIyODhhNDIyNS1jOTE1LTQwZDctOTc2YS04MDhiMWE3YTFmODYifQ..CBd_84Ll9vmcE2U7ZTlJBlbHddq9PX-r7gqXXZo-5f4"/>
<!--    <parameter name="driver.capabilities.takesScreenshot" value="false"></parameter>-->
<!--    <parameter name="driver.capabilities.screenshotOnError" value="true"></parameter>-->
<!--    <parameter name="driver.capabilities.bundleId" value="com.ubs.clientMobile"></parameter>-->

    <test name="iPhone CDX" enabled="true">
        <parameter name="driver.capabilities.deviceName" value="0C2210C8EBD9A1FB421A8D0A692E6C72F85E4C9E"></parameter>
        <parameter name="env.resources" value="src/main/resources/ios"/>

        <groups>
            <run>
                <include name="@cdxiPhone"/>
            </run>
        </groups>
        <classes>
            <class name="com.qmetry.qaf.automation.step.client.gherkin.GherkinScenarioFactory"/>
        </classes>
    </test>
    <test name="iPhone CDX 2" enabled="false">
        <parameter name="driver.capabilities.deviceName" value="00008110-000A5DDA1E00401E"></parameter>
        <parameter name="env.resources" value="src/main/resources/ios"/>

        <groups>
            <run>
                <include name="@cdxiPhone"/>
            </run>
        </groups>
        <classes>
            <class name="com.qmetry.qaf.automation.step.client.gherkin.GherkinScenarioFactory"/>
        </classes>
    </test>


</suite>

