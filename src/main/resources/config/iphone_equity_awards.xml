<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Equity Awards" verbose="0" parallel="tests" thread-count="2">
    <listeners>
        <listener class-name="com.quantum.listeners.QuantumReportiumListener"/>
    </listeners>

    <!-- To use actual AppiumDriver classes defined    -->
    <!-- by driverClass property in env.resources dirs -->
    <!-- Set driver.name value to perfectoDriver       -->
    <parameter name="driver.name" value="perfectoDriver"/>
 	<parameter name="driver.capabilities.perfecto:securityToken" value="${securityToken}"></parameter>



    <test name="iPhone Equity Awards 1" enabled="true">
        <parameter name="driver.capabilities.deviceName" value="00008130-00021D5E1A10001C"/>
        <parameter name="env.resources" value="src/main/resources/ios"/>

        <groups>
            <run>
                <include name="@iPhoneEquity"/>
            </run>
        </groups>
        <classes>
            <class name="com.qmetry.qaf.automation.step.client.gherkin.GherkinScenarioFactory"/>
        </classes>
    </test>
    <test name="iPhone Equity Awards 2" enabled="false">
        <parameter name="driver.capabilities.deviceName" value="00008120-001135960C68C01E"></parameter>
        <parameter name="env.resources" value="src/main/resources/ios"/>

        <groups>
            <run>
                <include name="@iPhoneEquity"/>
            </run>
        </groups>
        <classes>
            <class name="com.qmetry.qaf.automation.step.client.gherkin.GherkinScenarioFactory"/>
        </classes>
    </test>


</suite>

